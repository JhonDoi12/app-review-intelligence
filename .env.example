# Database (DATABASE_URL dipakai container; _LOCAL dipakai skrip di Ubuntu)
POSTGRES_USER=ari
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ari
DATABASE_URL=postgresql+psycopg://ari:change_me@db:5432/ari
DATABASE_URL_LOCAL=postgresql+psycopg://ari:change_me@localhost:5432/ari

# Scraper: jendela 91 hari = 13 minggu penuh
TARGET_APP_PACKAGE=com.whatsapp
SCRAPE_LANG=id
SCRAPE_COUNTRY=id
SCRAPE_SINCE=2026-08-19
SCRAPE_UNTIL=2026-11-17
SCRAPE_MAX_PER_WEEK=800
SCRAPE_SLEEP_SECONDS=1.5
USER_HASH_SALT=change_me

# Model
HF_MODEL_REPO=username/indobert-review-sentiment
